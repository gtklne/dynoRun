# Public Cloudflare Turnstile site key (safe to expose client-side).
# Gates sign-up and password reset. For local dev, use Cloudflare's
# "always passes" test site key:
#   1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Prefills the dev-only "Dev sign-in" panel on the login screen (dev builds only,
# stripped from prod). Pair with DEV_LOGIN=true in server/.env. See CLAUDE.md → Dev login.
VITE_DEV_LOGIN_EMAIL=

# Absolute origin of the API. Leave blank for web dev (Vite proxies /api).
# REQUIRED for native builds: the webview is served from its own origin, so a
# relative /api goes nowhere, and the OAuth callback would be built against
# capacitor://localhost. Set it to https://wasgoht.ch before `npm run cap:sync`.
VITE_API_URL=
