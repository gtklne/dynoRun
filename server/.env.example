# Postgres connection string.
DATABASE_URL=

# 32+ random bytes. Signs session cookies and one-time tokens.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. Used as better-auth's baseURL, as the CORS origin,
# and to build OAuth redirect URIs, so it must match the browser's address bar
# exactly (no trailing slash).
APP_URL=http://localhost:5173

PORT=3000

# Resend: delivers password-reset email only. Nothing else sends mail.
RESEND_API_KEY=
FROM_EMAIL=

# Cloudflare Turnstile secret. Gates /sign-up/email and /request-password-reset.
# Dev "always passes" test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Social sign-in. Each provider is registered ONLY when both of its variables
# are set, and GET /api/auth-providers reports which ones are live so the login
# screen renders exactly those buttons. Leave a pair blank to hide that button.
#
# Redirect URI to register with every provider:
#   <APP_URL>/api/auth/callback/<provider>
# e.g. https://wasgoht.ch/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Apple: CLIENT_ID is the Services ID (not the app bundle id), and CLIENT_SECRET
# is a JWT you generate from the .p8 signing key. Apple caps that JWT at 6
# months, so it must be regenerated before it expires or Apple sign-in breaks.
# APP_BUNDLE_IDENTIFIER lets ID tokens minted by the native iOS app validate too.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=com.dynorun.app

# Dev-only: mounts POST /api/dev/login, which mints a session for any email
# with no password and no captcha. Never set this in production.
DEV_LOGIN=
DEV_LOGIN_EMAIL=
